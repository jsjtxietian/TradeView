# Optional overrides only. The fixed token in trenddeck/config.py works without .env.
# Copy to .env if needed; systemd loads it after scripts/update-server.sh.
# Empty/unset token uses the fixed project token.
TRENDDECK_MCP_TOKEN=

# Comma-separated public Host values accepted by MCP behind your reverse proxy.
# Localhost and 127.0.0.1 on any port are already accepted.
# Example: stocks.example.com,stocks.example.com:443
TRENDDECK_MCP_ALLOWED_HOSTS=

# Normally empty: server-side agents do not send an Origin header.
# Set exact origins only if using a browser-based MCP client.
TRENDDECK_MCP_ALLOWED_ORIGINS=

# Optional data root; relative paths resolve from the project directory.
# Contains stock/ and trade/. Default: data
# TRENDDECK_DATA_DIR=/srv/trenddeck-data
